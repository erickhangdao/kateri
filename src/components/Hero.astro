---
import { Image } from "astro:assets";
import type { Settings } from "../lib/content";
import heroBanner from "../assets/images/hero-banner.webp";
import heroCoat from "../assets/images/hero-coat-of-arms-yellow-maple.webp";
interface Props {
  settings: Settings;
}
const { settings } = Astro.props;
---

<section id="home" class="hero" aria-labelledby="hero-title">
  <div class="hero-stage">
    <Image
      class="hero-banner"
      src={heroBanner}
      alt=""
      width={3280}
      height={1248}
      format="webp"
      loading="eager"
      fetchpriority="high"
    />
    <div class="container hero-intro">
      <Image
        class="hero-coat"
        src={heroCoat}
        alt="Liên Đoàn Kateri Tekakwitha coat of arms"
        width={600}
        format="webp"
        loading="eager"
      />
      <h1 id="hero-title">
        <span lang="vi">Liên Đoàn</span>
        <br />
        {settings.shortName}
      </h1>
      <p class="hero-english">{settings.englishName}</p>
      <p class="hero-description">{settings.introduction}</p>
      <div class="actions">
        <a class="button" href="#chapters">
          Discover our chapters
        </a>
        <a class="text-link" href="#announcements">
          Latest announcements
        </a>
      </div>
    </div>
  </div>
  <div class="motto-strip">
    <div class="container">
      <span class="motto-text" lang="la">
        {settings.motto}
      </span>
      <span class="motto-cross" aria-hidden="true">
        ✦
      </span>
      <span class="motto-text" lang="en">{settings.mottoTranslation}</span>
    </div>
  </div>
</section>