---
import { Image } from "astro:assets";
import { managedImage, type Settings } from "../lib/content";
interface Props {
  settings: Settings;
}
const { settings } = Astro.props;
---

<section id="home" class="hero" aria-labelledby="hero-title">
  <div class="container hero-intro">
    <Image
      class="hero-crest"
      src={managedImage(settings.logo)}
      alt="Kateri Tekakwitha league shield"
      width={240}
      height={240}
      format="webp"
      loading="eager"
      fetchpriority="high"
    />
    <h1 id="hero-title">
      <span lang="vi">Liên Đoàn</span>
      <br />
      {settings.shortName}
    </h1>
    <p class="hero-english">{settings.englishName}</p>
    <p class="hero-description">{settings.introduction}</p>
    <div class="actions">
      <a class="button" href="#chapters">
        Discover our chapters <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href="#announcements">
        Latest announcements <span aria-hidden="true">↓</span>
      </a>
    </div>
  </div>
  <div class="motto-strip">
    <div class="container">
      <span class="motto-latin" lang="la">
        {settings.motto}
      </span>
      <span class="motto-cross" aria-hidden="true">
        ✦
      </span>
      <span>{settings.mottoTranslation}</span>
    </div>
  </div>
</section>