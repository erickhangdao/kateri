---
import type { CollectionEntry } from "astro:content";
import ChapterMap from "./ChapterMap.astro";
import ChapterInfo from "./ChapterInfo.astro";
interface Props {
  chapters: CollectionEntry<"chapters">[];
}
const { chapters } = Astro.props;
const listChapters = [...chapters].sort((a, b) =>
  new Intl.Collator("vi", { sensitivity: "base" }).compare(a.data.name, b.data.name),
);
---

<section
  id="chapters"
  class="section home-section chapters-section"
  aria-labelledby="chapters-title"
>
  <div class="container">
    <div class="section-heading">
      <div>
        <h2 id="chapters-title">Our Chapters</h2>
      </div>
      <p>
        Find your chapter.
        <br />
        Grow in faith together.
      </p>
    </div>
    <div class="chapter-view-toolbar" hidden>
      <p>One community, across Ontario.</p>
      <div class="chapter-view-switch" role="group" aria-label="Chapter view">
        <button
          type="button"
          data-chapter-view="map"
          aria-pressed="true"
          aria-controls="chapter-map"
        >
          Map view
        </button>
        <button
          type="button"
          data-chapter-view="list"
          aria-pressed="false"
          aria-controls="chapter-list"
        >
          List view
        </button>
      </div>
    </div>
    <ChapterMap chapters={chapters} />
    <div class="chapter-grid" id="chapter-list">
      {listChapters.map(({ id, data }, index) => (
        <article class="chapter" id={`chapter-${id}`}>
          <div class="chapter-top">
            <span class="chapter-number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <span class="chapter-city">{data.city}</span>
          </div>
          <h3 lang="vi">
            {data.website || data.social ? (
              <a href={data.website || data.social}>
                {data.name}
              </a>
            ) : data.name}
          </h3>
          {data.parish && <p>{data.parish}</p>}
          <ChapterInfo chapter={data} />
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .chapter-view-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }
  .chapter-view-toolbar > p {
    font-size: 0.96rem;
    color: var(--muted);
  }
  .chapter-view-switch {
    display: flex;
    padding: 4px;
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 4px;
  }
  .chapter-view-switch button {
    border: 0;
    border-radius: 2px;
    background: transparent;
    padding: 9px 21px;
    min-height: 44px;
    cursor: pointer;
    color: var(--primary);
    font-size: 0.92rem;
    font-weight: 600;
  }
  .chapter-view-switch button[aria-pressed="true"] {
    background: var(--primary);
    color: white;
  }
  @media (max-width: 600px) {
    .chapter-view-toolbar {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }
    .chapter-view-switch {
      width: 100%;
    }
    .chapter-view-switch button {
      flex: 1;
    }
  }
</style>
