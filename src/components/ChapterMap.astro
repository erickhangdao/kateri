---
import type { CollectionEntry } from "astro:content";
import geography from "../data/ontario-map.json";
import { Image } from "astro:assets";
import { managedImage } from "../lib/content";
import leagueCrest from "../assets/images/crest.png";
interface Props {
  chapters: CollectionEntry<"chapters">[];
}
const { chapters } = Astro.props;
const [west, south, east, north] = geography.bounds;
const mapped = chapters.flatMap((chapter) => {
  const { latitude, longitude } = chapter.data;
  if (
    latitude == null ||
    longitude == null ||
    longitude < west ||
    longitude > east ||
    latitude < south ||
    latitude > north
  )
    return [];
  const point: [number, number] = [
    ((longitude - west) / (east - west)) * 800,
    ((north - latitude) / (north - south)) * 600,
  ];
  return [
    {
      ...chapter,
      point,
    },
  ];
});
---

<div id="chapter-map" hidden>
  <div class="map-layout">
    <div class="map-geography">
      <div
        class="map-canvas"
        role="group"
        aria-label="Interactive map of chapter communities in southern Ontario"
        aria-describedby="map-instructions"
      >
        <svg
          class="map-base"
          viewBox="0 0 800 600"
          aria-hidden="true"
          focusable="false"
        >
          <path d={geography.neighbours} class="neighbour-land" />
          <path d={geography.ontario} class="ontario-land" />
          <text x="377" y="65" class="province-label">
            ONTARIO
          </text>
          <text x="255" y="220" class="water-label">
            Lake Huron
          </text>
          <text x="372" y="505" class="water-label">
            Lake Erie
          </text>
          <text x="705" y="225" class="water-label">
            Lake Ontario
          </text>
          <text x="106" y="369" class="neighbour-label">
            MICHIGAN
          </text>
          <text x="696" y="459" class="neighbour-label">
            NEW YORK
          </text>
        </svg>
        <div class="ontario-overview" aria-hidden="true">
          <svg viewBox="0 0 150 164">
            <path d={geography.overview} />
            <rect x="82" y="130" width="40" height="32" rx="2" />
          </svg>
          <span>Southern Ontario</span>
        </div>
        <div class="map-north" aria-hidden="true">
          <span>↑</span>N
        </div>
        {mapped.map(({ id, data, point }, index) => (
          <button
            type="button"
            class="map-pin"
            data-chapter-pin={id}
            style={`left:${point[0] / 8}%;top:${point[1] / 6}%`}
            aria-label={`${data.city}: ${data.name}`}
            aria-pressed={index === 0 ? "true" : "false"}
            aria-controls="map-chapter-details"
          >
            <Image
              class="pin-crest"
              src={data.image ? managedImage(data.image) : leagueCrest}
              alt=""
              width={34}
              loading="lazy"
            />
            <span class="pin-city" aria-hidden="true">
              {data.city}
            </span>
          </button>
        ))}
      </div>
      <p class="map-caption">
        Approximate community locations ·{" "}
        <a href={geography.sourceUrl}>Map: Natural Earth</a>
      </p>
    </div>
    <div class="map-sidebar">
      <p id="map-instructions">
        Hover, tap, or focus a marker to meet a chapter.
      </p>
      <div id="map-chapter-details" aria-live="polite" aria-atomic="true">
        {mapped.map(({ id, data }, index) => (
          <article
            class="map-chapter-detail"
            data-chapter-detail={id}
            hidden={index !== 0}
          >
            <div class="map-detail-crest">
              <Image
                src={data.image ? managedImage(data.image) : leagueCrest}
                alt={data.image ? data.imageAlt || data.name + " crest" : "Liên Đoàn Kateri crest"}
                width={132}
                loading="lazy"
              />
            </div>
            <p class="map-city">
              {data.city} <span>· {data.province}</span>
            </p>
            <h3 lang="vi">
              {data.website || data.social ? (
                <a href={data.website || data.social}>
                  {data.name} <span aria-hidden="true">↗</span>
                </a>
              ) : data.name}
            </h3>
            {data.parish && <p class="map-parish">{data.parish}</p>}
          </article>
        ))}
      </div>
      <div class="map-pagination">
        <span>
          <span data-map-count>1</span> of {mapped.length} communities
        </span>
        <div>
          <button
            type="button"
            data-map-step="-1"
            aria-label="Previous chapter"
          >
            ←
          </button>
          <button type="button" data-map-step="1" aria-label="Next chapter">
            →
          </button>
        </div>
      </div>
    </div>
  </div>
  {mapped.length < chapters.length && (
    <p class="unmapped-note">Additional chapters are available in List view.</p>
  )}
</div>

<script>
  const section = document.querySelector<HTMLElement>("#chapters");
  if (section) {
    const map = section.querySelector<HTMLElement>("#chapter-map")!;
    const list = section.querySelector<HTMLElement>("#chapter-list")!;
    const toolbar = section.querySelector<HTMLElement>(
      ".chapter-view-toolbar",
    )!;
    const switches = [
      ...section.querySelectorAll<HTMLButtonElement>("[data-chapter-view]"),
    ];
    const pins = [
      ...section.querySelectorAll<HTMLButtonElement>("[data-chapter-pin]"),
    ];
    const details = [
      ...section.querySelectorAll<HTMLElement>("[data-chapter-detail]"),
    ];
    let selected = 0;
    const showView = (view: string) => {
      map.hidden = view !== "map";
      list.hidden = view !== "list";
      switches.forEach((button) =>
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.chapterView === view),
        ),
      );
    };
    const selectChapter = (index: number) => {
      selected = (index + pins.length) % pins.length;
      const id = pins[selected].dataset.chapterPin;
      pins.forEach((pin, i) =>
        pin.setAttribute("aria-pressed", String(i === selected)),
      );
      details.forEach((detail) => {
        detail.hidden = detail.dataset.chapterDetail !== id;
      });
      section.querySelector<HTMLElement>("[data-map-count]")!.textContent =
        String(selected + 1);
    };
    const showLinkedChapter = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (
        id.startsWith("chapter-") &&
        list.querySelector(`[id="${CSS.escape(id)}"]`)
      ) {
        showView("list");
        document.getElementById(id)?.scrollIntoView({ block: "start" });
        return true;
      }
      return false;
    };
    if (pins.length) {
      toolbar.hidden = false;
      showView("map");
      showLinkedChapter();
      window.addEventListener("hashchange", showLinkedChapter);
      switches.forEach((button) =>
        button.addEventListener("click", () =>
          showView(button.dataset.chapterView!),
        ),
      );
      pins.forEach((pin, index) => {
        pin.addEventListener("pointerenter", (event) => {
          if (event.pointerType !== "touch") selectChapter(index);
        });
        pin.addEventListener("focus", () => selectChapter(index));
        pin.addEventListener("click", () => selectChapter(index));
        pin.addEventListener("keydown", (event) => {
          if (
            ![
              "ArrowRight",
              "ArrowDown",
              "ArrowLeft",
              "ArrowUp",
              "Home",
              "End",
            ].includes(event.key)
          )
            return;
          event.preventDefault();
          const next =
            event.key === "Home"
              ? 0
              : event.key === "End"
                ? pins.length - 1
                : selected +
                  (["ArrowRight", "ArrowDown"].includes(event.key) ? 1 : -1);
          selectChapter(next);
          pins[selected].focus();
        });
      });
      section
        .querySelectorAll<HTMLButtonElement>("[data-map-step]")
        .forEach((button) =>
          button.addEventListener("click", () =>
            selectChapter(selected + Number(button.dataset.mapStep)),
          ),
        );
    }
  }
</script>

<!-- Keep below-the-fold map styles local without another render-blocking request. -->
<style is:inline>
  .map-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    border: 1px solid var(--border);
  }
  .map-geography {
    background: #e7efec;
    min-width: 0;
    container-type: inline-size;
  }
  .map-canvas {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .map-base {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ontario-land {
    fill: #f4f4e9;
    stroke: #a7b8a8;
    stroke-width: 1.2;
  }
  .neighbour-land {
    fill: #dde4db;
    stroke: #b7c5b9;
    stroke-width: 1;
  }
  .province-label {
    fill: #4f6757;
    font-size: 17px;
    letter-spacing: 7px;
    text-anchor: middle;
  }
  .water-label {
    fill: #526e68;
    font-family: var(--heading-font);
    font-size: 17px;
    font-style: italic;
    text-anchor: middle;
  }
  .neighbour-label {
    fill: #617061;
    font-size: 11px;
    letter-spacing: 3px;
    text-anchor: middle;
  }
  .ontario-overview {
    position: absolute;
    top: 20px;
    left: 20px;
    width: 108px;
    padding: 10px;
    background: #fffefae6;
    border: 1px solid #c5d1c8;
  }
  .ontario-overview svg {
    width: 100%;
    display: block;
    height: 98px;
  }
  .ontario-overview path {
    fill: #d3dfd0;
    stroke: #6b856c;
    stroke-width: 1.3;
  }
  .ontario-overview rect {
    fill: #00422526;
    stroke: var(--primary);
    stroke-width: 2;
  }
  .ontario-overview span {
    display: block;
    text-align: center;
    font-size: 9px;
    color: var(--primary);
    margin-top: 5px;
  }
  .map-north {
    position: absolute;
    right: 19px;
    top: 18px;
    color: var(--primary);
    font-size: 10px;
    display: grid;
    justify-items: center;
    line-height: 1.1;
  }
  .map-north span {
    font-size: 24px;
  }
  .map-pin {
    position: absolute;
    transform: translate(-50%, -50%);
    border: 0;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    cursor: pointer;
    z-index: 1;
  }
  .map-pin .pin-crest {
    display: block;
    width: 34px;
    height: 34px;
    object-fit: contain;
    margin: 5px auto;
    filter: drop-shadow(0 2px 2px #15392b80);
    transition: transform 0.16s, filter 0.16s;
  }
  .map-pin:hover,
  .map-pin:focus-visible,
  .map-pin[aria-pressed="true"] {
    z-index: 3;
  }
  .map-pin:hover .pin-crest,
  .map-pin:focus-visible .pin-crest,
  .map-pin[aria-pressed="true"] .pin-crest {
    transform: scale(1.18);
    filter: drop-shadow(0 3px 4px #15392ba6);
  }
  .pin-city {
    display: none;
    position: absolute;
    top: 42px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 12px;
    line-height: 1.3;
    font-weight: 600;
    background: var(--primary);
    border-radius: 2px;
    padding: 3px 5px;
    color: white;
    pointer-events: none;
  }
  .map-pin:hover .pin-city,
  .map-pin:focus-visible .pin-city,
  .map-pin[aria-pressed="true"] .pin-city {
    display: block;
  }
  .map-pin:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }
  .map-caption {
    font-size: 0.7rem;
    color: #465e51;
    margin: 0;
    padding: 11px 18px;
    border-top: 1px solid #cbd9d0;
  }
  .map-sidebar {
    background: var(--primary);
    color: white;
    padding: 32px;
    display: flex;
    flex-direction: column;
  }
  #map-instructions {
    font-size: 0.88rem;
    line-height: 1.6;
    color: #d6e6dd;
    margin-top: 0;
  }
  .map-detail-crest {
    height: 142px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 18px 0 14px;
  }
  .map-detail-crest img {
    display: block;
    max-width: 132px;
    max-height: 132px;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .map-city {
    font-size: 0.84rem;
    line-height: 1.4;
    color: #e1c99e;
  }
  .map-city span {
    white-space: nowrap;
  }
  .map-chapter-detail h3 {
    font-size: 1.85rem;
    line-height: 1.35;
    margin: 12px 0 16px;
  }
  .map-chapter-detail h3 a {
    color: inherit;
    text-decoration: none;
    text-underline-offset: 0.18em;
  }
  .map-chapter-detail h3 a:hover,
  .map-chapter-detail h3 a:focus-visible {
    text-decoration: underline;
  }
  .map-chapter-detail h3 a span {
    font-family: var(--body-font);
    font-size: 0.68em;
  }
  .map-parish {
    font-size: 0.94rem;
    color: #d6e6dd;
    line-height: 1.65;
  }
  .map-pagination {
    border-top: 1px solid #ffffff40;
    padding-top: 20px;
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  #map-chapter-details {
    padding-bottom: 30px;
    min-height: 380px;
  }
  .map-pagination > span {
    font-size: 0.75rem;
    color: #d6e6dd;
  }
  .map-pagination > div {
    display: flex;
    gap: 6px;
  }
  .map-pagination button {
    width: 44px;
    height: 44px;
    border: 1px solid #ffffff70;
    background: transparent;
    color: white;
    font-size: 1.2rem;
    cursor: pointer;
  }
  .map-pagination button:hover {
    background: #ffffff18;
  }
  .unmapped-note {
    font-size: 0.9rem;
    color: var(--muted);
    margin-top: 15px;
  }
  @container (max-width: 570px) {
    .pin-city {
      display: none;
    }
    .ontario-overview {
      width: 80px;
      top: 12px;
      left: 12px;
      padding: 7px;
    }
    .ontario-overview svg {
      height: 65px;
    }
    .ontario-overview span {
      font-size: 8px;
    }
  }
  @media (max-width: 1000px) {
    .map-layout {
      grid-template-columns: minmax(0, 1fr) 285px;
    }
    .map-sidebar {
      padding: 24px;
    }
  }
  @media (max-width: 800px) {
    .map-layout {
      grid-template-columns: 1fr;
    }
    .map-sidebar {
      padding: 25px;
    }
    .map-detail-crest {
      height: 116px;
      margin-top: 6px;
    }
    .map-detail-crest img {
      max-height: 110px;
      max-width: 110px;
    }
    .map-city {
      margin-top: 24px;
    }
    .map-chapter-detail h3 {
      font-size: 1.7rem;
    }
    #map-chapter-details {
      min-height: 244px;
      padding-bottom: 24px;
    }
    .map-pagination {
      padding-top: 15px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .map-pin {
      transition: none;
    }
  }
</style>
