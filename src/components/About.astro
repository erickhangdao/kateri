---
import { Image } from "astro:assets";
import { managedImage, type Settings } from "../lib/content";
interface Props {
  settings: Settings;
}
const { settings } = Astro.props;
---

<section
  id="about"
  class="section home-section container about-grid"
  aria-labelledby="about-title"
>
  <div>
    <h2 id="about-title">About</h2>
    <p class="lead">{settings.about}</p>
    <p>{settings.history}</p>
    {settings.introductionVi && <p lang="vi">{settings.introductionVi}</p>}
    <a class="text-link" href={settings.veymUrl}>
      Get to know VEYM Canada <span aria-hidden="true">↗</span>
    </a>
  </div>
  <aside class="patron">
    {settings.patronImage && (
      <Image
        src={managedImage(settings.patronImage)}
        alt={settings.patronAlt}
        width={180}
        format="webp"
        loading="lazy"
      />
    )}
    <div>
      <h3>St. Kateri Tekakwitha</h3>
      <p>{settings.patronText}</p>
      <p class="patron-prayer">Saint Kateri, pray for us.</p>
    </div>
  </aside>
</section>
