---
import BaseLayout from "../layouts/BaseLayout.astro";
Astro.response.status = 404;
---

<BaseLayout title="Page not found | Liên Đoàn Kateri" noindex>
  <div class="container section narrow">
    <p class="eyebrow">PAGE NOT FOUND</p>
    <h1>Let’s find your way.</h1>
    <p class="lead">
      This page may have moved. Find current notices and useful documents below.
    </p>
    <div class="actions" style="margin-top:2rem">
      <a class="button" href="/">
        Return home
      </a>
      <a class="text-link" href="/resources/">
        Browse resources
      </a>
    </div>
  </div>
</BaseLayout>
